{
  "name": "@deepseek-ai/dsh-desktop",
  "private": true,
  "version": "0.1.0-1",
  "description": "Community Tauri 2 desktop distribution of DeepSeek Harness",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "package": "tauri build --ci",
    "package:windows-x64": "tauri build --ci --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "package:macos-arm64": "tauri build --ci --target aarch64-apple-darwin --bundles app,dmg",
    "package:linux-x64": "tauri build --ci --target x86_64-unknown-linux-gnu --bundles appimage,deb,rpm",
    "package:linux-arm64": "tauri build --ci --target aarch64-unknown-linux-gnu --bundles appimage,deb,rpm",
    "check": "tauri info"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
